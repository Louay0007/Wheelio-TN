# Wheelio TN — local backend foundation
NODE_ENV=development
APP_URL=http://localhost:3000

# PostgreSQL (Compose maps host 5433 → container 5432)
DATABASE_URL=postgresql://wheelio:wheelio@localhost:5433/wheelio

# Redis / BullMQ (Compose maps host 6380 → container 6379)
REDIS_URL=redis://localhost:6380

# Better Auth (min 32 chars)
BETTER_AUTH_SECRET=dev-only-change-me-wheelio-tn-secret-key-32
# BETTER_AUTH_URL=http://localhost:3000

# MinIO / S3-compatible object storage (Compose maps 9010/9011)
MINIO_ENDPOINT=localhost
MINIO_PORT=9010
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=wheelio
MINIO_SECRET_KEY=wheelio-secret
MINIO_PUBLIC_BUCKET=wheelio-public
MINIO_PRIVATE_BUCKET=wheelio-private
MINIO_QUARANTINE_BUCKET=wheelio-quarantine

# SMTP (Mailpit Compose maps host 1125 → 1025, UI 8125)
SMTP_HOST=localhost
SMTP_PORT=1125
SMTP_FROM=Wheelio TN <noreply@wheelio.tn>
# SMTP_USER=
# SMTP_PASS=

LOG_LEVEL=info
WORKER_CONCURRENCY=5

# Stub payment webhook HMAC (sha256 hex of raw body). Also signs payment client secrets.
PAYMENT_WEBHOOK_SECRET=dev-only-payment-webhook-secret

# ---------------------------------------------------------------------------
# API cutover flag matrix (Stage 6)
# Defaults: AUTH/CATALOG/CHECKOUT on; AGENCY/ADMIN opt-in.
#
# | Flag                              | Surfaces gated                          | Demo LS as truth |
# |-----------------------------------|-----------------------------------------|------------------|
# | NEXT_PUBLIC_API_SLICE_AUTH=1      | login/account/sessions/drivers          | no               |
# | NEXT_PUBLIC_API_SLICE_CATALOG=1   | search/locations/agencies/CMS           | no               |
# | NEXT_PUBLIC_API_SLICE_CHECKOUT=1  | quotes/holds/bookings/trips/payments    | no               |
# | NEXT_PUBLIC_API_SLICE_AGENCY=1    | agency ops + team/settings/calendar/    | no               |
# |                                   | reviews/reports/finance/prepare/issues  |                  |
# | NEXT_PUBLIC_API_SLICE_ADMIN=1     | admin ops + agencies/claims/flags/      | no               |
# |                                   | promotions/locations/staff/audit/       |                  |
# |                                   | invoices/reconciliation/analytics       |                  |
#
# Full cutover (all slices authoritative):
#   NEXT_PUBLIC_API_SLICE_AUTH=1
#   NEXT_PUBLIC_API_SLICE_CATALOG=1
#   NEXT_PUBLIC_API_SLICE_CHECKOUT=1
#   NEXT_PUBLIC_API_SLICE_AGENCY=1
#   NEXT_PUBLIC_API_SLICE_ADMIN=1
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_SLICE_AUTH=1
NEXT_PUBLIC_API_SLICE_CATALOG=1
NEXT_PUBLIC_API_SLICE_CHECKOUT=1
NEXT_PUBLIC_API_SLICE_AGENCY=0
NEXT_PUBLIC_API_SLICE_ADMIN=0
